# ==========================================================
# OKESIH.COM Environment Variables (Template)
# ==========================================================
# PERHATIAN KEAMANAN:
# - NEXT_PUBLIC_* diekspos ke browser / Client Components (gunakan ANON KEY).
# - SUPABASE_SERVICE_ROLE_KEY HANYA untuk backend / server-side.
# JANGAN PERNAH menambahkan prefix NEXT_PUBLIC_ ke Service Role Key!
# ==========================================================

# URL Aplikasi (digunakan untuk metadata, redirection, dll)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SUPERADMIN_WHATSAPP_NUMBER="6285694488510"

# Supabase Public API (Aman untuk Client Component PWA)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-jwt"

# Supabase Backend Service Role Key (SERVER ONLY - Bypasses RLS)
# Wajib diset di Vercel Environment Variables untuk Production/Preview
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Supabase New Management API / Secret Key (Server only, opsional)
SUPABASE_SECRET_API_KEY="your-supabase-secret-api-key"

# Otorisasi Vercel Cron untuk pembersihan bukti transfer setelah 90 hari
CRON_SECRET="generate-a-random-secret-at-least-16-characters"

# Worker WhatsApp Web memakai NEXT_PUBLIC_SUPABASE_URL dan SERVICE ROLE di atas.
# Jalankan hanya pada perangkat/VPS super admin yang selalu aktif:
# npm run whatsapp:worker
